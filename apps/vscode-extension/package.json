      },
      {
        "command": "llmatic.reviewExternalPullRequest",
        "title": "Review External Pull Request",
        "category": "LLMatic"
      },
      {
        "command": "llmatic.configureAutoReview",
        "title": "Configure Auto Review Agent",
        "category": "LLMatic"
      },
      {
        "command": "llmatic.openReviewLog",
        "title": "Open Review Log",
        "category": "LLMatic"
      },
      {
        "command": "llmatic.toggleReviewActivityLogging",
        "title": "Toggle Review Activity Logging",
        "category": "LLMatic"
      },
      {
        "command": "llmatic.connectJiraWorkspace",
        "title": "Connect Jira Workspace",
        "category": "LLMatic"
      },
      {
        "command": "llmatic.disconnectJiraWorkspace",
        "title": "Disconnect Jira Workspace",
        "category": "LLMatic"
      },
      {
        "command": "llmatic.openConnectionCenter",
        "title": "External Connections",
        "category": "LLMatic"
      },
      {
        "command": "llmatic.connectKiloGateway",
        "title": "Connect Kilo Gateway",
        "category": "LLMatic"
      }
    ],
    "configuration": {
      "title": "LLMatic Agent Runtime",
      "properties": {
        "llmatic.autoAttachWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Automatically attach opened repository workspaces to LLMatic."
        },
        "llmatic.autoConnectKilo": {
          "type": "boolean",
          "default": true,
          "description": "Automatically register the global LLMatic MCP server when Kilo Code is installed."
        },
        "llmatic.nodeCommand": {
          "type": "string",
          "default": "node",
          "description": "Node.js executable used by Kilo Code to launch the bundled LLMatic MCP server."
        },
        "llmatic.runtimeMcpPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to an alternative LLMatic MCP server entry file."
        },
        "llmatic.agentModel": {
          "type": "string",
          "default": "kilo-auto/free",
          "description": "Kilo Gateway model used by the direct LLMatic coding agent. Defaults to Auto Free."
        },
        "llmatic.agentMaxSteps": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 50,
          "description": "Maximum model/tool rounds for one direct LLMatic agent run."
        },
        "llmatic.reviewMaxSteps": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 30,
          "description": "Maximum model/tool rounds for the ordinary local code-review lens."
        },
        "llmatic.externalReviewMaxSteps": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 8,
          "description": "Maximum model/repair rounds per bounded external PR review batch. External PR diff evidence is preloaded and the batch is tool-free."
        },
        "llmatic.reviewRequestTimeoutMs": {
          "type": "number",
          "default": 120000,
          "minimum": 30000,
          "maximum": 300000,
          "description": "Hard timeout for one external PR review model candidate. Defaults to 120 seconds so thinking-capable free models can finish bounded reviews before adaptive routing switches candidates."
        },
        "llmatic.reviewFreeModelFallbacks": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 8,
          "description": "Maximum live free-model candidates tried for one external PR review request when the selected model is Auto Free or another explicit free model. Kilo Auto Free is reserved as the final fallback when available."
        },
        "llmatic.releaseRepository": {
          "type": "string",
          "default": "pikkst/llmatic-agent-runtime",
          "description": "GitHub owner/repository used by LLMatic update checks."
        },
        "llmatic.taskSource": {
          "type": "string",
          "enum": [
            "auto",
            "jira",
            "markdown",
            "github"
          ],
          "default": "auto",
          "description": "Canonical task source for workspace recovery. Auto uses detected sources; choose Jira to prefer Jira even when TASKS.md exists."
        },
        "llmatic.jiraProjectKey": {
          "type": "string",
          "default": "",
          "description": "Optional Jira project key used to scope automatic recovery and next-task ordering."
        },
        "llmatic.jiraRecoveryJql": {
          "type": "string",
          "default": "",
          "description": "Optional advanced Jira JQL override for recovery candidates. When empty, LLMatic uses assigned open work ordered by Jira Rank."
        },
        "llmatic.jiraWorkMode": {
          "type": "string",
          "enum": [
            "assigned_only",
            "project_queue"
          ],
          "default": "assigned_only",
          "description": "Fallback Jira work-ownership mode when no workspace Jira profile is connected. assigned_only is team-safe; project_queue is for solo/full-project queues."
        },
        "llmatic.connectionBrokerUrl": {
          "type": "string",
          "default": "",
          "description": "HTTPS origin of the LLMatic browser OAuth broker. Required for one-click Atlassian OAuth; manual Jira credentials remain available when empty."
        },
        "llmatic.allowAnonymousKiloFree": {
          "type": "boolean",
          "default": true,
          "description": "Allow direct LLMatic agent/review requests to use Kilo anonymous access when the selected model is kilo-auto/free or another explicit free model."
        },
        "llmatic.reviewActivityLogging": {
          "type": "boolean",
          "default": true,
          "description": "Record sanitized live and persistent review activity telemetry (phases, model/tool steps and timings). Prompt text and source-code contents are never written unless raw-response debug logging is explicitly enabled."
        },
        "llmatic.reviewRawResponseLogging": {
          "type": "boolean",
          "default": false,
          "description": "DEBUG ONLY: capture bounded raw assistant responses before JSON/schema filtering during external PR review, including Auto Review. Raw output may contain changed source-code content and is written to the local review activity log."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "llmatic",
          "title": "LLMatic",
          "icon": "media/llmatic.svg"
        }
      ]
    },
    "views": {
      "llmatic": [
        {
          "id": "llmatic.agentChat",
          "name": "Agent Chat",
          "type": "webview"
        },
        {
          "id": "llmatic.status",
          "name": "Runtime Status"
        }
      ]
