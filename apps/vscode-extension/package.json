{
  "name": "llmatic-agent-runtime",
  "displayName": "LLMatic Agent Runtime",
  "description": "Attach LLMatic Agent Runtime to local repositories without adding runtime state to the repository.",
  "version": "0.1.0",
  "publisher": "eventnexus",
  "type": "module",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.cjs",
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "package:vsix": "node scripts/package-vsix.mjs"
  },
  "dependencies": {
    "@llmatic/core": "workspace:*",
    "@llmatic/kilo-connector": "workspace:*",
    "@llmatic/workspace-manager": "workspace:*",
    "@llmatic/agent-orchestrator": "workspace:*",
    "@llmatic/gateway-client": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "1.105.0",
    "esbuild": "0.28.2",
    "@vscode/vsce": "4.0.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "llmatic.attachWorkspace",
        "title": "Attach Workspace",
        "category": "LLMatic"
      },
      {
        "command": "llmatic.connectKilo",
        "title": "Connect Kilo Code Globally",
        "category": "LLMatic"
      },
      {
        "command": "llmatic.showStatus",
        "title": "Show Status",
        "category": "LLMatic"
      },
      {
        "command": "llmatic.doctor",
        "title": "Doctor",
        "category": "LLMatic"
      },
      {
        "command": "llmatic.setKiloGatewayApiKey",
        "title": "Set Kilo Gateway API Key",
        "category": "LLMatic"
      },
      {
        "command": "llmatic.clearKiloGatewayApiKey",
        "title": "Clear Kilo Gateway API Key",
        "category": "LLMatic"
      },
      {
        "command": "llmatic.runAgent",
        "title": "Run Gateway Agent",
        "category": "LLMatic"
      },
      {
        "command": "llmatic.openWorkspaceData",
        "title": "Reveal Workspace Runtime Data",
        "category": "LLMatic"
      }
    ],
    "configuration": {
      "title": "LLMatic Agent Runtime",
      "properties": {
        "llmatic.autoAttachWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Automatically attach opened repository workspaces to LLMatic."
        },
        "llmatic.autoConnectKilo": {
          "type": "boolean",
          "default": true,
          "description": "Automatically register the global LLMatic MCP server when Kilo Code is installed."
        },
        "llmatic.nodeCommand": {
          "type": "string",
          "default": "node",
          "description": "Node.js executable used by Kilo Code to launch the bundled LLMatic MCP server."
        },
        "llmatic.runtimeMcpPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to an alternative LLMatic MCP server entry file."
        },
        "llmatic.agentModel": {
          "type": "string",
          "default": "kilo-auto/free",
          "description": "Kilo Gateway model used by the direct LLMatic coding agent. Defaults to Auto Free."
        },
        "llmatic.agentMaxSteps": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 50,
          "description": "Maximum model/tool rounds for one direct LLMatic agent run."
        }
      }
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pikkst/llmatic-agent-runtime.git",
    "directory": "apps/vscode-extension"
  }
}
