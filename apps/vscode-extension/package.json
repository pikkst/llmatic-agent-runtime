        "title": "Generate Project Plan",
        "category": "LLMatic"
      },
      {
        "command": "llmatic.reviewPlan",
        "title": "Review Project Plan",
        "category": "LLMatic"
      },
      {
        "command": "llmatic.planReview",
        "title": "Review & Approve Project Plan",
        "category": "LLMatic"
      },
      {
        "command": "llmatic.editPlanDecisions",
        "title": "Edit Project Decisions",
        "category": "LLMatic"
      },
      {
        "command": "llmatic.requestPlanChanges",
        "title": "Request Project Plan Changes",
        "category": "LLMatic"
      },
      {
        "command": "llmatic.approveAndInitialize",
        "title": "Approve & Initialize Project",
        "category": "LLMatic"
      },
      {
        "command": "llmatic.getReady",
        "title": "Get Ready",
        "category": "LLMatic"
      },
      {
        "command": "llmatic.attachWorkspace",
        "title": "Attach Workspace",
        "category": "LLMatic"
      },
      {
        "command": "llmatic.bootstrapWorkspace",
        "title": "Bootstrap Workspace",
        "category": "LLMatic"
      },
      {
        "command": "llmatic.connectKilo",
        "title": "Connect Kilo Code Globally",
        "category": "LLMatic"
      },
      {
        "command": "llmatic.showStatus",
        "title": "Show Status",
        "category": "LLMatic"
      },
      {
        "command": "llmatic.checkForUpdates",
        "title": "Check for Updates",
        "category": "LLMatic"
      },
      {
        "command": "llmatic.installUpdate",
        "title": "Install Latest Update",
        "category": "LLMatic"
      },
      {
        "command": "llmatic.doctor",
        "title": "Doctor",
        "category": "LLMatic"
      },
      {
