{
  "name": "llmatic-agent-runtime",
  "displayName": "LLMatic Agent Runtime",
  "description": "Deterministic local software-engineering runtime for AI coding agents, with Kilo Code integration, project discovery, planning, review and safe workflow automation.",
  "version": "0.3.2",
  "publisher": "eventnexus",
  "type": "module",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.cjs",
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "package:vsix": "node scripts/package-vsix.mjs"
  },
  "dependencies": {
    "@llmatic/core": "workspace:*",
    "@llmatic/kilo-connector": "workspace:*",
    "@llmatic/workspace-manager": "workspace:*",
    "@llmatic/agent-orchestrator": "workspace:*",
    "@llmatic/gateway-client": "workspace:*",
    "@llmatic/review-engine": "workspace:*",
    "@llmatic/bootstrap-manager": "workspace:*",
    "@llmatic/runtime-installer": "workspace:*",
    "@llmatic/setup-health": "workspace:*",
    "@llmatic/release-metadata": "workspace:*",
    "@llmatic/update-installer": "workspace:*",
    "@llmatic/discovery-engine": "workspace:*",
    "@llmatic/planning-engine": "workspace:*",
    "@llmatic/project-initializer": "workspace:*",
    "@llmatic/workspace-recovery": "workspace:*",
    "@llmatic/repository-constitution": "workspace:*",
    "@llmatic/pr-draft": "workspace:*",
    "@llmatic/jira-adapter": "workspace:*",
    "@llmatic/task-router": "workspace:*",
    "@llmatic/github-adapter": "workspace:*",
    "@llmatic/external-connections": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "1.105.0",
    "esbuild": "0.28.2",
    "@vscode/vsce": "4.0.0"
  },
  "contributes": {
