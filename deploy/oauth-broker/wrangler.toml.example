name = "llmatic-oauth-broker"
main = "worker.mjs"
compatibility_date = "2026-09-22"

# Configure these in the deployed environment:
# [vars]
# ATLASSIAN_CLIENT_ID = "..."
# ATLASSIAN_REDIRECT_URI = "https://<worker>/v1/connections/callback/atlassian"
#
# Set ATLASSIAN_CLIENT_SECRET with:
#   wrangler secret put ATLASSIAN_CLIENT_SECRET
#
# Create a KV namespace and replace the id:
# [[kv_namespaces]]
# binding = "CONNECTION_SESSIONS"
# id = "<kv-namespace-id>"
